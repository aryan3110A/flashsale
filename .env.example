# ---- FlashSale configuration (copy to .env). Local development defaults only. ----
# CHANGE every password/token below before deploying anywhere that is not your own machine.

# Public ports (the only two published to the host)
WEB_PORT=3000
GATEWAY_PORT=8080

# URL the BROWSER uses to reach the gateway (baked into the web build; rebuild web after changing)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
# Origins the gateway accepts for CORS (comma separated)
CORS_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_DB=flashsale
POSTGRES_USER=flashsale
POSTGRES_PASSWORD=change_me_local

# Token Bucket rate limiter (per client IP): `REFILL_RATE` tokens are added every `REFILL_INTERVAL` ms, up to CAPACITY
RATE_LIMIT_CAPACITY=40
RATE_LIMIT_REFILL_RATE=20
RATE_LIMIT_REFILL_INTERVAL=1000
# Separate, generous bucket for /health and /metrics endpoints
RATE_LIMIT_HEALTH_CAPACITY=300
RATE_LIMIT_HEALTH_REFILL_RATE=150
RATE_LIMIT_HEALTH_REFILL_INTERVAL=1000

# Circuit breaker around the mock downstream service
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RESET_TIMEOUT_MS=10000
CIRCUIT_HALF_OPEN_MAX_CALLS=1
CIRCUIT_SUCCESS_THRESHOLD=2
MOCK_TIMEOUT_MS=2500

# Retry (gateway, safe requests only) and BullMQ job retry
RETRY_MAX_ATTEMPTS=2
JOB_ATTEMPTS=4
JOB_BACKOFF_MS=1000

# Cache + worker
CACHE_TTL_SECONDS=30
WORKER_CONCURRENCY=5
WORKER_PROCESSING_MIN_MS=400
WORKER_PROCESSING_MAX_MS=1200

# Demo helpers (fault injection + cache-clear button). Turn off for anything public.
ENABLE_CHAOS=true
ENABLE_DEMO_ENDPOINTS=true

LOG_LEVEL=info
